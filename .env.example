# Copy this file to .env and replace the placeholder with your actual token.
# .env is listed in .gitignore — never commit your real token.
#
# gpt-oss-120b is served through the Hugging Face Inference Providers router.
# Create a token at https://huggingface.co/settings/tokens
# It needs the "Make calls to Inference Providers" permission.

HF_TOKEN=hf_your_token_here

# generate.py also accepts HUGGINGFACE_API_KEY or OPENAI_API_KEY as the
# variable name, so an existing .env does not have to be renamed.
